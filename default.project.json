{
  "name": "Clean Old Stuff",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared",
        "$ignoreUnknownInstances": true
      }
    },

    "ServerScriptService": {
      "$path": "src/server",
      "$ignoreUnknownInstances": true
    },

    "StarterGui": {
      "$properties": {
        "VirtualCursorMode": "Default"
      },
      "$ignoreUnknownInstances": true
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/client",
        "$ignoreUnknownInstances": true
      }
    }
  }
}
